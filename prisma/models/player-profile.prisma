enum PlayerLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Sport {
  code      String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  playerProfiles PlayerProfile[]

  @@map("sports")
}

model PlayerProfile {
  id             String       @id @default(uuid()) @db.Uuid
  accountId      String       @unique @map("account_id") @db.Uuid
  displayName    String?      @map("display_name")
  mainSportCode  String?      @map("main_sport_code")
  mainSportLevel PlayerLevel? @map("main_sport_level")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  account   Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mainSport Sport?  @relation(fields: [mainSportCode], references: [code], onDelete: Restrict)

  @@index([mainSportCode])
  @@index([mainSportLevel])
  @@map("player_profiles")
}
